# .npmrc configuration for ling-term-mcp

# Prevent accidentally publishing tests and other files
# This is handled by the "files" field in package.json

# Use legacy peer deps to avoid warnings during installation
legacy-peer-deps=true

# Set timeout for operations
fetch-timeout=60000
fetch-retries=2

# Use npm registry (uncomment if using custom registry)
# registry=https://registry.npmjs.org/

# Save exact versions
save-exact=true

# Use npm scripts
engine-strict=true

# Prevent using .npmrc in home directory
userconfig=/dev/null
