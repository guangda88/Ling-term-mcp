{
  "name": "ling-term-mcp",
  "version": "1.1.0",
  "description": "Ling-term-mcp (灵犀) - AI terminal operations MCP server",
  "main": "dist/index.js",
  "bin": {
    "ling-term-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "test": "jest tests/unit --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:e2e": "tsx --test tests/e2e/cli.test.ts",
    "test:stress": "tsx tests/stress/stress-tests.ts",
    "test:coverage": "jest tests/unit --coverage --runInBand",
    "test:watch": "jest tests/unit --watch --runInBand",
    "lint": "eslint src tests --ext .ts --resolve-plugins-relative-to .",
    "lint:fix": "eslint src tests --ext .ts --fix --resolve-plugins-relative-to .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rimraf dist coverage",
    "prepublishOnly": "npm run clean && npm run build",
    "prepare": "husky install || true",
    "docs": "typedoc --out docs/api src",
    "optimize": "cd optimization && python3 optimize_mcp_params.py",
    "verify": "tsx scripts/verify-publish.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "terminal",
    "ai",
    "claude",
    "cursor",
    "copilot",
    "ling-term-mcp",
    "灵犀"
  ],
  "author": "Guangda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/guangda/ling-term-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/guangda/ling-term-mcp/issues"
  },
  "homepage": "https://github.com/guangda/ling-term-mcp#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ling/protocol": "file:../ling-protocol",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.4.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
